// Copy to Config/Local.xcconfig (gitignored) and set your own values.
// Bundle ID must be unique to your Apple Developer account.
CAIRN_BUNDLE_ID = com.example.cairncompanion
CAIRN_TEAM_ID = YOURTEAMID
// The dashboard's host name (no scheme, no port), so the app can use its passkeys. Append
// ?mode=developer while the dashboard is only reachable on your own network: iOS then fetches the
// association file from the device instead of Apple's CDN (needs Settings > Developer > Associated
// Domains Development on, and a development-signed build).
CAIRN_PASSKEY_DOMAIN = cairn.example.lan?mode=developer
